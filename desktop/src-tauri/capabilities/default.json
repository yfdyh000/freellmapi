{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the FreeLLMAPI Tauri shell",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "freellmapi-sidecar",
          "sidecar": true,
          "args": [
            "--db",
            { "validator": "\\S+" },
            "--client-dist",
            { "validator": "\\S+" },
            "--host",
            { "validator": "\\S+" },
            "--port",
            { "validator": "\\d+" }
          ]
        }
      ]
    }
  ]
}
